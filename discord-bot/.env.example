# Fill these three values locally. Never send your token in chat or commit .env.
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
# Optional: use a persistent disk path when hosting. One bot instance per database.
DISCORD_DB_PATH=./data/careers.sqlite

# Firebase: leave blank until the project, Firestore and credentials are ready.
# Once enabled, startup imports SQLite additively and writes all new DC progress to Firestore.
FIREBASE_PROJECT_ID=
# Secret: set directly in Railway Variables, never in GitHub or chat.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional Google Sheets mirror (source of truth remains Firebase)
GOOGLE_SHEETS_ID=
